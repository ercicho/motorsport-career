rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/career/{saveId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId
        && saveId == 'main'
        && request.resource.data.keys().hasOnly(['data', 'revision', 'updatedAt', 'schemaVersion'])
        && request.resource.data.data is map
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updatedAt is int
        && request.resource.data.schemaVersion == 1
      allow delete: if false;
    }
  }
}
